#!/bin/sh
set -eu

if ! xcrun --find swift-format >/dev/null 2>&1; then
    echo "pre-commit: swift-format not found (requires Xcode), skipping format check" >&2
    exit 0
fi

staged_swift_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')

if [ -z "$staged_swift_files" ]; then
    exit 0
fi

if ! echo "$staged_swift_files" | xargs xcrun swift-format lint --configuration .swift-format --strict; then
    echo "pre-commit: staged Swift files are not formatted" >&2
    echo "pre-commit: run 'xcrun swift-format format --configuration .swift-format -i <file>...', restage, and commit again" >&2
    exit 1
fi
